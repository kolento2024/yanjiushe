<!--pages/my/my.wxml-->
<navigation-bar title="我的" background="#FFFFFF" color="#3D3D3D"></navigation-bar>

<scroll-view class="scrollarea" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- 用户信息区 -->
  <view class="user-section">
    <view class="user-card">
      <!-- 未登录 -->
      <block wx:if="{{!isLoggedIn}}">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <view class="avatar-placeholder">
            <text class="avatar-icon">👤</text>
          </view>
          <text class="login-hint">点击登录</text>
        </button>
        <view class="nickname-box">
          <input
            class="nickname-input"
            type="nickname"
            placeholder="设置昵称"
            bindinput="onNickInput"
            bindblur="onNickBlur"
          />
        </view>
      </block>
      <!-- 已登录 -->
      <block wx:else>
        <button class="avatar-btn-logged" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-img" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
        </button>
        <view class="nickname-box">
          <input
            class="nickname-input logged"
            type="nickname"
            placeholder="设置昵称"
            value="{{userInfo.nickName}}"
            bindinput="onNickInput"
            bindblur="onNickBlur"
          />
        </view>
      </block>
    </view>
  </view>

  <!-- 菜单区 -->
  <view class="menu-section">
    <view
      class="menu-item"
      wx:for="{{menus}}"
      wx:key="key"
      bindtap="onMenuTap"
      data-key="{{item.key}}"
    >
      <view class="menu-left">
        <text class="menu-icon">{{item.icon}}</text>
        <view class="menu-text">
          <text class="menu-label">{{item.label}}</text>
          <text class="menu-desc">{{item.desc}}</text>
        </view>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="bottom-space"></view>

</scroll-view>

<!-- 底部菜单 -->
<tab-bar current="my"></tab-bar>
