/**pages/my/my.wxss**/
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #FDF8F5;
}

.scrollarea {
  flex: 1;
}

/* ====== 用户信息 ====== */
.user-section {
  padding: 32rpx 28rpx 0;
}

.user-card {
  position: relative;
  background: #FFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  padding: 56rpx 40rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.avatar-btn::after {
  border: none;
}

.avatar-btn-logged {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 80rpx !important;
  overflow: hidden;
  background: transparent;
  line-height: 1;
}

.avatar-btn-logged::after {
  border: none;
  border-radius: 80rpx !important;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 4rpx solid #D48B8B;
}

.avatar-placeholder {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FDF8F8, #F5EBEB);
  border: 4rpx dashed #D48B8B;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.avatar-icon {
  font-size: 72rpx;
  opacity: 0.5;
}

.login-hint {
  font-size: 28rpx;
  color: #D48B8B;
  margin-top: 8rpx;
}

.nickname-box {
  margin-top: 24rpx;
  width: 100%;
  display: flex;
  justify-content: center;
}

.nickname-input {
  width: 300rpx;
  height: 72rpx;
  background: #FDF8F5;
  border-radius: 36rpx;
  text-align: center;
  font-size: 30rpx;
  color: #3D3D3D;
  padding: 0 24rpx;
}

.nickname-input.logged {
  font-weight: 600;
  background: transparent;
}

/* ====== 菜单 ====== */
.menu-section {
  margin: 32rpx 28rpx 0;
  background: #FFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid #F5F0EB;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #FDF8F8;
}

.menu-left {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 24rpx;
}

.menu-text {
  display: flex;
  flex-direction: column;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #3D3D3D;
  margin-bottom: 4rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
}

.menu-arrow {
  font-size: 36rpx;
  color: #CCC;
  font-weight: 300;
}

/* ====== 订阅通知 ====== */
.subscribe-item {
  margin-top: 16rpx;
}

.subscribe-item:last-child {
  border-bottom: none;
}

.subscribe-badge {
  flex-shrink: 0;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.subscribe-badge.on {
  background: #E8F5E9;
  color: #4CAF50;
}

.subscribe-badge.off {
  background: #F5F0EB;
  color: #999;
}

/* 底部占位 */
.bottom-space {
  height: 32rpx;
}

/* ====== 角色角标 ====== */
.role-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.role-badge.student {
  background: #FDF0F0;
  color: #D48B8B;
  border: 2rpx solid #F5E6E6;
}

.role-badge.manager {
  background: linear-gradient(135deg, #D48B8B, #C07474);
  color: #FFF;
}

/* ====== 授权弹窗 ====== */
.auth-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.auth-modal {
  width: 560rpx;
  background: #FFF;
  border-radius: 24rpx;
  overflow: hidden;
}

.auth-modal-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 20rpx;
}

.auth-modal-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #3D3D3D;
}

.auth-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #BBB;
  border-radius: 50%;
}

.auth-modal-close:active {
  background: #F5F0EB;
}

.auth-modal-body {
  padding: 0 32rpx 24rpx;
}

.auth-modal-desc {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 24rpx;
}

.auth-code-input {
  width: 100%;
  height: 88rpx;
  background: #FDF8F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #3D3D3D;
  text-align: center;
  letter-spacing: 8rpx;
  box-sizing: border-box;
}

.auth-error {
  font-size: 24rpx;
  color: #E74C3C;
  display: block;
  text-align: center;
  margin-top: 16rpx;
}

.auth-modal-footer {
  display: flex;
  flex-direction: row;
  border-top: 1rpx solid #F5F0EB;
}

.auth-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.auth-btn.cancel {
  color: #999;
  border-right: 1rpx solid #F5F0EB;
}

.auth-btn.confirm {
  color: #D48B8B;
  font-weight: 600;
}

.auth-btn:active {
  background: #FDF8F8;
}
