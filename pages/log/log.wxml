<!--pages/log/log.wxml-->
<navigation-bar title="操作日志" background="#FFFFFF" color="#3D3D3D"></navigation-bar>

<scroll-view class="scrollarea" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- 日期筛选 -->
  <view class="filter-bar">
    <picker mode="date" value="{{filterDate}}" bindchange="onFilterDateChange">
      <view class="filter-date-btn">
        <text class="filter-date-icon">📅</text>
        <text class="filter-date-text">{{filterDateText}}</text>
        <text class="filter-date-arrow">▼</text>
      </view>
    </picker>
    <view class="filter-today-btn" bindtap="onFilterToday">
      <text>今天</text>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="empty-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="empty-title">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:elif="{{isEmpty}}">
    <view class="empty-icon-wrap">
      <text class="empty-icon">📋</text>
    </view>
    <text class="empty-title">暂无操作日志</text>
    <text class="empty-desc">预约和取消操作的记录会显示在这里</text>
  </view>

  <!-- 日志列表 -->
  <view class="log-list" wx:else>
    <block wx:for="{{filteredLogs}}" wx:key="_id">
      <view class="log-card">
        <view class="log-card-left">
          <view class="log-ver-line" style="background: {{typeColors[item.type] || '#D48B8B'}}"></view>
        </view>
        <view class="log-card-right">
          <view class="log-card-header">
            <view class="log-type-tag" style="background: {{typeColors[item.type] || '#D48B8B'}}15; color: {{typeColors[item.type] || '#D48B8B'}}">
              {{typeLabels[item.type] || '操作'}}
            </view>
            <text class="log-time">{{item.time}}</text>
          </view>
          <text class="log-detail">{{item.detail}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="bottom-space"></view>
</scroll-view>

<!-- 清空按钮 -->
<view class="clear-bar" wx:if="{{!isEmpty && !loading}}">
  <view class="clear-btn" bindtap="onClear">
    <text>清空所有日志</text>
  </view>
</view>
