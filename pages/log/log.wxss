/**pages/log/log.wxss**/
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #FDF8F5;
}

.scrollarea {
  flex: 1;
}

/* ====== 日期筛选栏 ====== */
.filter-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 28rpx;
  gap: 16rpx;
}

.filter-date-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #FFF;
  border: 1rpx solid #F0E6E6;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
}

.filter-date-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.filter-date-text {
  font-size: 26rpx;
  color: #3D3D3D;
}

.filter-date-arrow {
  font-size: 20rpx;
  color: #BBB;
  margin-left: 8rpx;
}

.filter-today-btn {
  font-size: 24rpx;
  color: #D48B8B;
  padding: 10rpx 24rpx;
  border: 1rpx solid #F5E6E6;
  border-radius: 32rpx;
  background: #FFF;
}

.filter-today-btn:active {
  background: #FDF8F8;
}

.filter-clear-btn {
  font-size: 24rpx;
  color: #999;
  padding: 10rpx 24rpx;
  border: 1rpx solid #E0D6D0;
  border-radius: 32rpx;
  background: #FFF;
}

.filter-clear-btn:active {
  background: #F5F0EB;
}

/* ====== 加载中 ====== */
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #F0EBE6;
  border-top-color: #D48B8B;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ====== 空状态 ====== */
.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon-wrap {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FDF0F0, #FDF8F5);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 139, 139, 0.1);
}

.empty-icon {
  font-size: 64rpx;
  opacity: 0.7;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #3D3D3D;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
}

/* ====== 日志列表 ====== */
.log-list {
  padding: 24rpx 28rpx;
}

.log-card {
  display: flex;
  flex-direction: row;
  margin-bottom: 0;
  position: relative;
}

.log-card-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40rpx;
  flex-shrink: 0;
  position: relative;
}

.log-ver-line {
  width: 4rpx;
  flex: 1;
  border-radius: 2rpx;
  min-height: 100%;
}

.log-card:last-child .log-ver-line {
  background: linear-gradient(to bottom, var(--start-color, #D48B8B), transparent 60%) !important;
}

/* 给每张卡加上竖线连接 */
.log-card:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 18rpx;
  top: 0;
  bottom: 0;
  width: 4rpx;
  background: #EDE4DC;
  border-radius: 2rpx;
  z-index: 0;
}

.log-card-left {
  z-index: 1;
}

.log-card-right {
  flex: 1;
  background: #FFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.04);
  padding: 24rpx 28rpx;
  margin-left: 20rpx;
  margin-bottom: 24rpx;
  min-width: 0;
  position: relative;
  z-index: 1;
}

/* 左侧小三角指向时间线 */
.log-card-right::before {
  content: '';
  position: absolute;
  left: -12rpx;
  top: 32rpx;
  width: 0;
  height: 0;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-right: 12rpx solid #FFF;
}

.log-card-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.log-type-tag {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  line-height: 1.4;
}

.log-time {
  font-size: 22rpx;
  color: #BBB;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.log-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.7;
  word-break: break-all;
}

/* 底部占位 */
.bottom-space {
  height: 120rpx;
}

/* ====== 清空栏 ====== */
.clear-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: row;
  justify-content: center;
  background: linear-gradient(to top, rgba(253, 248, 245, 1) 0%, rgba(253, 248, 245, 0.85) 80%, transparent);
}

.clear-btn {
  font-size: 26rpx;
  color: #D48B8B;
  padding: 16rpx 40rpx;
  border-radius: 48rpx;
  background: #FFF;
  box-shadow: 0 4rpx 20rpx rgba(212, 139, 139, 0.15);
  border: 1rpx solid #F5E6E6;
  transition: all 0.3s;
}

.clear-btn:active {
  background: #FDF8F8;
  transform: scale(0.97);
}
