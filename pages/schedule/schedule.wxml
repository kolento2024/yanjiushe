<!--pages/schedule/schedule.wxml-->
<navigation-bar title="课程表" background="#FFFFFF" color="#3D3D3D"></navigation-bar>

<!-- 日期筛选栏 -->
<view class="filter-bar">
  <view class="filter-row">
    <!-- 日期选择器 -->
    <picker class="picker-wrapper" mode="date" value="{{pickerDate}}" start="{{pickerStart}}" end="{{pickerEnd}}" bindchange="onPickerDateChange">
      <view class="picker-btn">
        <text class="picker-icon">📅</text>
        <text class="picker-label">{{pickerDateText || '选择日期'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
    <!-- 快捷筛选 -->
    <scroll-view class="filter-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="filter-list">
        <view
          class="filter-tag {{filterDate === item.date ? 'active' : ''}}"
          wx:for="{{dateFilters}}"
          wx:key="date"
          bindtap="filterByDate"
          data-date="{{item.date}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- 内容区域 -->
<view class="list-area">

  <!-- 加载中 -->
  <view class="loading-wrap" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-wrap" wx:elif="{{isEmpty}}">
    <text class="empty-icon">📋</text>
    <text class="empty-title">暂无预约课程</text>
    <text class="empty-desc">预约成功后，课程信息会显示在这里</text>
    <view class="btn-primary empty-btn" bindtap="goBook">
      <text>去预约</text>
    </view>
  </view>

  <!-- 课程列表 -->
  <scroll-view class="schedule-scroll" scroll-y enhanced show-scrollbar="{{false}}" wx:else>
    <view class="schedule-list">
      <block wx:for="{{displayBookings}}" wx:key="date">
        <!-- 日期标题 -->
        <view class="date-header">
          <view class="date-header-left">
            <view class="date-dot"></view>
            <text class="date-title">{{item.dateLabel}}</text>
          </view>
          <text class="date-count">共{{item.items.length}}节课</text>
        </view>

        <!-- 课程卡片 -->
        <view class="course-card" wx:for="{{item.items}}" wx:for-item="booking" wx:key="_id">
          <view class="course-time-side">
            <text class="course-time">{{booking.bookingTime}}</text>
            <text class="course-time-end">{{booking.bookingEndTime || ''}}</text>
          </view>
          <view class="course-body">
            <view class="course-top-row">
              <view class="course-tag" style="background: {{booking.serviceColor || '#D48B8B'}}20; color: {{booking.serviceColor || '#D48B8B'}}">
                {{booking.serviceName}}
              </view>
              
            </view>
            <view class="course-info">
              <view class="course-info-item">
                <text class="info-icon">👤</text>
                <text class="info-text">{{booking.name}}</text>
              </view>
              <view class="course-info-item">
                <text class="info-icon">📞</text>
                <text class="info-text">{{booking.phoneMasked}}</text>
              </view>
              <view class="course-remark" wx:if="{{booking.remark}}">
                <text class="remark-icon">📝</text>
                <text class="remark-text">{{booking.remark}}</text>
              </view>
            </view>
          </view>
          <view class="course-action">
            <view class="course-price">¥{{booking.servicePrice}}</view>
            <view class="cancel-btn" bindtap="cancelBooking" data-id="{{booking._id}}">
              <text>取消</text>
            </view>
          </view>
        </view>
      </block>
    </view>
    <view class="schedule-bottom"></view>
  </scroll-view>
</view>
