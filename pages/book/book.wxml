<!--pages/book/book.wxml-->
<navigation-bar title="化妆预约" background="#FFFFFF" color="#3D3D3D"></navigation-bar>

<scroll-view class="scrollarea" scroll-y enhanced show-scrollbar="{{false}}">

  <!-- 预约表单 -->
  <view class="book-form" wx:if="{{!showSuccess}}">

    <!-- 步骤提示 -->
    <view class="steps-bar">
      <view class="step active">
        <text class="step-num">1</text>
        <text class="step-label">选项目</text>
      </view>
      <view class="step-line"></view>
      <view class="step {{selectedDate ? 'active' : ''}}">
        <text class="step-num">2</text>
        <text class="step-label">选时间</text>
      </view>
      <view class="step-line"></view>
      <view class="step {{name && phone ? 'active' : ''}}">
        <text class="step-num">3</text>
        <text class="step-label">填信息</text>
      </view>
    </view>

    <!-- 选择化妆项目 -->
    <view class="form-section">
      <view class="form-section-title">
        <text class="title-icon">💄</text>
        <text>选择化妆项目</text>
      </view>
      <view class="service-list">
        <view
          class="service-option {{selectedServiceId === item.id ? 'selected' : ''}}"
          wx:for="{{services}}"
          wx:key="id"
          bindtap="selectService"
          data-id="{{item.id}}"
        >
          <image class="service-option-img" src="{{item.icon}}" mode="aspectFill" />
          <view class="service-option-body">
            <view class="service-option-left">
              <view class="service-top-row">
                <view class="service-option-name">{{item.name}}</view>
              </view>
              <text class="service-option-desc">{{item.desc}}</text>
              <view class="service-option-bottom">
                <text class="service-option-time">⏱ {{item.time}}</text>
              </view>
            </view>
            <view class="service-option-right">
              <text class="service-option-price">¥{{item.price}}</text>
              <view class="radio-circle {{selectedServiceId === item.id ? 'checked' : ''}}">
                <text wx:if="{{selectedServiceId === item.id}}" class="radio-dot">✓</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 选择日期 -->
    <view class="form-section">
      <view class="form-section-title">
        <text class="title-icon">📅</text>
        <text>选择日期（近3个月）</text>
      </view>
      <scroll-view class="date-scroll" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="date-list">
          <block wx:for="{{dateList}}" wx:key="date">
            <view class="month-label" wx:if="{{item.isNewMonth}}">{{item.monthLabel}}</view>
            <view
              class="date-item {{selectedDate === item.date ? 'selected' : ''}}"
              bindtap="selectDate"
              data-date="{{item.date}}"
            >
              <text class="date-week">{{item.isToday ? '今天' : '周' + item.weekDay}}</text>
              <text class="date-day">{{item.month}}/{{item.day}}</text>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>

    <!-- 选择时段 -->
    <view class="form-section">
      <view class="form-section-title">
        <text class="title-icon">🕐</text>
        <text>选择时段（可多选）</text>
        <text class="time-range">（9:00 - 19:00）</text>
      </view>
      <view class="time-grid">
        <view
          class="time-item {{item.disabled ? 'disabled' : ''}} {{item.selected ? 'selected' : ''}}"
          wx:for="{{timeSlots}}"
          wx:key="value"
          bindtap="selectTime"
          data-time="{{item.value}}"
          data-disabled="{{item.disabled}}"
        >
          <text class="time-label">{{item.label}}</text>
          <text class="time-reason" wx:if="{{item.disabled && item.disabledReason}}">{{item.disabledReason}}</text>
        </view>
      </view>
    </view>

    <!-- 填写信息 -->
    <view class="form-section">
      <view class="form-section-title">
        <text class="title-icon">📝</text>
        <text>填写信息</text>
      </view>
      <view class="input-group">
        <view class="input-item">
          <text class="input-label">姓名</text>
          <input
            class="input-field"
            placeholder="请输入您的姓名"
            value="{{name}}"
            bindinput="onNameInput"
            maxlength="20"
          />
        </view>
        <view class="input-item">
          <text class="input-label">激活码</text>
          <input
            class="input-field"
            type="number"
            placeholder="请输入手机4位尾号"
            value="{{phone}}"
            bindinput="onPhoneInput"
            maxlength="4"
          />
        </view>
        <view class="input-item remark-item">
          <text class="input-label">备注</text>
          <textarea
            class="input-field remark-field"
            placeholder="如有特殊需求请在此填写（如：过敏体质、指定化妆师等）"
            value="{{remark}}"
            bindinput="onRemarkInput"
            maxlength="200"
            auto-height
          />
        </view>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section safe-bottom">
      <view class="submit-info" wx:if="{{selectedServiceId && selectedDate && selectedTime}}">
        <text class="submit-summary">
          {{services[selectedServiceId-1].name}} · {{dateText}} · {{selectedTime}}
        </text>
        <text class="submit-price">¥{{services[selectedServiceId-1].price}}</text>
      </view>
      <view
        class="btn-primary submit-btn {{submitting ? 'submitting' : ''}}"
        bindtap="submitBooking"
      >
        <text wx:if="{{!submitting}}">确认预约</text>
        <text wx:else>提交中...</text>
      </view>
    </view>

  </view>

  <!-- 预约成功 -->
  <view class="success-wrap" wx:if="{{showSuccess}}">
    <view class="success-card">
      <view class="success-icon-wrap">
        <text class="success-icon">✓</text>
      </view>
      <text class="success-title">预约成功！</text>
      <text class="success-desc">我们已收到您的预约，请按时到店～</text>

      <view class="success-detail">
        <view class="detail-row">
          <text class="detail-label">化妆项目</text>
          <text class="detail-value">{{bookingResult.serviceName}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">预约日期</text>
          <text class="detail-value">{{bookingResult.date}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">预约时段</text>
          <text class="detail-value">{{bookingResult.time}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">预约人</text>
          <text class="detail-value">{{bookingResult.name}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">联系电话</text>
          <text class="detail-value">{{bookingResult.phone}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">预计费用</text>
          <text class="detail-value detail-price">¥{{bookingResult.servicePrice}}</text>
        </view>
      </view>

      <view class="success-actions">
        <view class="btn-primary success-btn" bindtap="bookAgain">
          <text>继续预约</text>
        </view>
        <view class="btn-outline success-btn" bindtap="goHome">
          <text>返回首页</text>
        </view>
      </view>
    </view>
  </view>

</scroll-view>

<!-- 底部菜单 -->
<tab-bar current="book"></tab-bar>
