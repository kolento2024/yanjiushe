/**pages/about/about.wxss**/
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #FDF8F5;
}

.scrollarea {
  flex: 1;
}

.about-wrap {
  padding: 32rpx 28rpx;
}

/* ====== 品牌卡片 ====== */
.brand-card {
  background: linear-gradient(135deg, #FFF5F5, #FFFBF8);
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(212, 139, 139, 0.08);
}

.brand-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #D48B8B, #C07474);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 139, 139, 0.25);
}

.brand-icon {
  font-size: 56rpx;
}

.brand-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #3D3D3D;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.brand-slogan {
  font-size: 26rpx;
  color: #C07474;
  letter-spacing: 4rpx;
}

/* ====== 介绍卡片 ====== */
.intro-card {
  background: #FFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.card-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #3D3D3D;
}

.title-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #D48B8B;
  margin-right: 14rpx;
}

.intro-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.85;
  margin-bottom: 16rpx;
  display: block;
}

.intro-text:last-child {
  margin-bottom: 0;
}

/* ====== 信息卡片 ====== */
.info-card {
  background: #FFF;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.03);
}

.info-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.info-row:last-of-type {
  margin-bottom: 0;
}

.info-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.info-right {
  display: flex;
  flex-direction: column;
}

.info-text {
  font-size: 28rpx;
  color: #3D3D3D;
  line-height: 1.6;
}

.info-tip {
  font-size: 22rpx;
  color: #BBB;
  margin-top: 6rpx;
}

.copy-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  background: linear-gradient(135deg, #D48B8B, #C07474);
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFF;
  margin-top: 4rpx;
  box-shadow: 0 4rpx 16rpx rgba(212, 139, 139, 0.25);
}

.copy-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.bottom-space {
  height: 48rpx;
}
