/**pages/add-student/add-student.wxss**/
page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #FDF8F5;
}

.scrollarea {
  flex: 1;
}

.form-area {
  padding: 24rpx 28rpx;
  display: flex;
  flex-direction: column;
}

/* ====== 表单区块 ====== */
.form-section {
  background: #FFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #3D3D3D;
  margin-bottom: 24rpx;
}

.title-dot {
  width: 10rpx;
  height: 28rpx;
  border-radius: 5rpx;
  margin-right: 14rpx;
}

.label-required {
  color: #D48B8B;
  font-size: 28rpx;
  margin-left: 4rpx;
}

/* ====== 输入项 ====== */
.form-item {
  margin-bottom: 20rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.item-label {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.label-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #555;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #FDF8F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #3D3D3D;
  box-sizing: border-box;
}

/* ====== 服务选择 ====== */
.service-list {
  display: flex;
  flex-direction: column;
}

.service-tag {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  background: #FDF8F5;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
  -webkit-tap-highlight-color: transparent;
  transition: border-color 0.2s, background 0.2s;
}

.service-tag:last-child {
  margin-bottom: 0;
}

.service-tag.selected {
  background: linear-gradient(135deg, #FDF0F0, #FFF5F0);
  border-color: #D48B8B;
}

.service-name {
  font-size: 26rpx;
  color: #3D3D3D;
  flex: 1;
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.service-tag.selected .service-name {
  color: #C07474;
  font-weight: 600;
}

.service-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #D48B8B;
  flex-shrink: 0;
}

/* ====== 选项卡片 ====== */
.option-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.option-row-three .option-card {
  flex: 1;
  min-width: 0;
}

.option-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  background: #FDF8F5;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  -webkit-tap-highlight-color: transparent;
  transition: border-color 0.2s, background 0.2s;
}

.option-card.selected {
  background: linear-gradient(135deg, #FDF0F0, #FDF8F5);
  border-color: #D48B8B;
}

.option-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.option-icon {
  font-size: 30rpx;
}

.option-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #3D3D3D;
}

.option-card.selected .option-label {
  color: #D48B8B;
}

.option-tip {
  font-size: 20rpx;
  color: #BBB;
  margin-top: 6rpx;
  text-align: center;
}

.option-card.selected .option-tip {
  color: #C9A096;
}

/* ====== 备注 ====== */
.form-textarea {
  width: 100%;
  height: 160rpx;
  background: #FDF8F5;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #3D3D3D;
  box-sizing: border-box;
}

/* ====== 提交按钮 ====== */
.submit-bar {
  margin-top: 8rpx;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  background: linear-gradient(135deg, #D48B8B, #C07474);
  border-radius: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(212, 139, 139, 0.3);
  transition: all 0.2s;
}

.submit-btn text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFF;
}

.submit-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.submit-btn.disabled {
  opacity: 0.6;
}

/* ====== 底部占位 ====== */
.bottom-space {
  height: 48rpx;
}
